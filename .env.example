# ============================================================
# CookHero 环境变量模板
# ============================================================
# 复制此文件为 .env 并填入真实值
#   cp .env.example .env

# --- LLM API Keys (阿里云 DashScope) ---
# 快速层 API Key（qwen-plus，用于意图检测、查询改写等轻量任务）
  FAST_LLM_API_KEY=your-fast-llm-api-key-here
# 标准层 API Key（qwen-max，用于最终回答生成）
  LLM_API_KEY=your-llm-api-key-here

# --- 数据库密码 ---
  DATABASE_PASSWORD=your-postgres-password
# Redis 密码（Docker 部署通常无密码，留空即可）
  REDIS_PASSWORD=

# --- JWT 安全密钥 ---
# 必须设置！用 openssl rand -hex 32 生成
  JWT_SECRET_KEY=your-jwt-secret-key-here

# --- 可选：视觉模型 API Key ---
# VISION_API_KEY=your-vision-api-key-here

# --- 可选：Web 搜索 API Key (Tavily) ---
# 配置后 Agent 使用 Tavily 联网搜索；未配置时降级为 DuckDuckGo 免费搜索
# WEB_SEARCH_API_KEY=your-tavily-api-key-here
